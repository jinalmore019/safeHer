{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/download",
        "destination": "https://expo.dev/artifacts/eas/WLK7txcCa_7jcwrVKI5Ak9XLMW3TrGP-DczmlXbCH2k.apk",
        "type": 302
      },
      {
        "source": "/feedback",
        "destination": "https://docs.google.com/forms/d/e/1FAIpQLSfyL2x98pil6jC_tUC8zZKluK1O56eQrTz2Sk-P53O71LjKSQ/viewform",
        "type": 302
      },
      {
        "source": "/video",
        "destination": "https://youtu.be/2oXYaOBMSh0?si=elFHAW0-avq3B3nYw",
        "type": 302
      },
      {
        "source": "/presentation",
        "destination": "https://docs.google.com/presentation/d/your-presentation-id-here/edit",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/track/**",
        "destination": "/track/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      }
    ]
  }
}
